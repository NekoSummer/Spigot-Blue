From 1054858441dddadb5817ebc444fffe184258a148 Mon Sep 17 00:00:00 2001
From: XinYueNeko <3649745663@qq.com>
Date: Sat, 12 Sep 2026 19:02:19 +0800
Subject: [PATCH] add-version-codename


diff --git a/src/main/java/cn/xinyue_neko/spigot_blue/VersionInfo.java b/src/main/java/cn/xinyue_neko/spigot_blue/VersionInfo.java
index 841480207..3411eaeaf 100644
--- a/src/main/java/cn/xinyue_neko/spigot_blue/VersionInfo.java
+++ b/src/main/java/cn/xinyue_neko/spigot_blue/VersionInfo.java
@@ -2,8 +2,13 @@ package cn.xinyue_neko.spigot_blue;
 
 public class VersionInfo {
     private final static String spigotBlueName = "SpigotBlue";
+    private final static String spigotBlueCodename = "Summer";
 
     public static String getServerName() {
         return spigotBlueName;
     }
+
+    public static String getCodeNameInfo() {
+        return spigotBlueCodename;
+    }
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index de585cb37..a9bdf0757 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -445,6 +445,11 @@ public final class CraftServer implements Server {
         return serverName;
     }
 
+    @Override
+    public String getCodename() {
+        return VersionInfo.getCodeNameInfo();
+    }
+
     @Override
     public String getVersion() {
         return serverVersion + " (MC: " + console.getVersion() + ")";
-- 
